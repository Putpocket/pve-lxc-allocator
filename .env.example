# Internal-network deployments only. Do not expose this app directly to the internet.
PROXMOX_HOST=proxmox.example.com
PROXMOX_USER=allocator@pve
PROXMOX_TOKEN_NAME=lxc-allocator
PROXMOX_TOKEN_VALUE=
PROXMOX_VERIFY_SSL=true
PROXMOX_REALM=pve
LXC_ROLE=PVEVMUser

LXC_START_VMID=100
LXC_END_VMID=199
ADMIN_PASSWORD=
APP_SECRET_KEY=

APP_LANGUAGE=en
APP_TITLE="Proxmox LXC Allocator"
INSTANCE_LABEL="Development containers"
CONTACT_TEXT="Contact ops@example.com for help."
ALLOCATION_FILE=issued_log.csv
SESSION_COOKIE_SECURE=true
